// This is your Prisma schema file for Travla BD
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  GUIDE
  COMPANY
  SUPER_ADMIN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TransportType {
  BUS
  TRAIN
  FLIGHT
  CAR_RENTAL
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  phone       String?    @unique
  password    String
  address     String?
  companyName String?
  avatar      String?
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  isVerified  Boolean    @default(false)

  reviews      Review[]
  reservations Reservation[]
  favorites    Favorite[]
  tripPlans    TripPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Destination {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  district    String
  category    String
  coverImage  String
  images      String[]
  rating      Float    @default(0.0)
  price       Float?   @default(0.0)
  isFeatured  Boolean  @default(false)

  reviews      Review[]
  favorites    Favorite[]
  reservations Reservation[]
  tripItems    TripPlanItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("destinations")
}

model Hotel {
  id            String   @id @default(cuid())
  name          String
  location      String
  description   String
  pricePerNight Float
  rating        Float    @default(0.0)
  coverImage    String
  images        String[]
  amenities     String[]
  contactPhone  String?

  reviews      Review[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hotels")
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  location    String
  cuisineType String
  description String
  priceRange  String
  rating      Float    @default(0.0)
  coverImage  String
  images      String[]

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurants")
}

model Transportation {
  id            String        @id @default(cuid())
  type          TransportType
  operatorName  String
  routeFrom     String
  routeTo       String
  estimatedCost Float
  duration      String
  scheduleTime  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transportations")
}

model TripPlan {
  id          String   @id @default(cuid())
  title       String
  startDate   DateTime
  endDate     DateTime
  totalBudget Float?   @default(0.0)
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  items TripPlanItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trip_plans")
}

model TripPlanItem {
  id            String      @id @default(cuid())
  tripPlanId    String
  tripPlan      TripPlan    @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  visitDate     DateTime?
  notes         String?

  @@map("trip_plan_items")
}

model Review {
  id            String       @id @default(cuid())
  rating        Int
  comment       String
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  hotelId       String?
  hotel         Hotel?       @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  restaurantId  String?
  restaurant    Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model Favorite {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, destinationId])
  @@map("favorites")
}

model Reservation {
  id            String            @id @default(cuid())
  status        ReservationStatus @default(PENDING)
  totalCost     Float
  startDate     DateTime
  endDate       DateTime
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String?
  destination   Destination?      @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  hotelId       String?
  hotel         Hotel?            @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reservations")
}
