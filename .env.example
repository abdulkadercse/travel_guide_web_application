# User Interface Layer (SRS 7.1) — frontend only.
# All backend and database secrets live in server/.env, never here.

# Base URL of the Express API (Application Server Layer)
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Cloudinary cloud name is public and only used to build image URLs
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
